{
  "name": "backend-tp2-pio-socket",
  "version": "1.0.0",
  "description": "Backend base para el TP2 (Pio Socket) - Router, searchParams y Socket.IO",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "pkg . --targets node18-win-x64 --output build/backend-tp2.exe",
    "home": "nodemon --env-file=.home.env index.js",
    "pio": "nodemon --env-file=.pio.env index.js"
  },
  "keywords": [
    "socket.io",
    "express",
    "nextjs",
    "backend"
  ],
  "author": "Ing. Pablo Morandi",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.3.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "mysql2": "^3.24.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pkg": "^5.8.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
